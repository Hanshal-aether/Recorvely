# Postgres (from Supabase: Project Settings > Database > Connection string)
DATABASE_URL="postgresql://user:password@host:5432/postgres"

# Redis (from Upstash: database details page)
REDIS_URL="rediss://default:password@host:6379"

# Razorpay test mode keys (Dashboard > Settings > API Keys, Test Mode ON)
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxx"

# Gemini API key (from aistudio.google.com)
GEMINI_API_KEY="xxxxxxxxxxxxxxxxxxxx"

# Which LLM provider the classifier abstraction should use.
# Swapping providers later means changing this one value, nothing else.
LLM_PROVIDER="gemini"

# Max retry attempts before a transaction is escalated instead of retried again
MAX_RETRY_ATTEMPTS=3

# NextAuth session encryption. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-value"
NEXTAUTH_URL="http://localhost:3000"

# Used only by scripts/generateSyntheticData.ts - generate this from the
# dashboard's API keys panel after you sign up and log in.
SEED_API_KEY=""
