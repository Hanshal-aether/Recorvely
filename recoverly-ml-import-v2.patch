+ ("discover","51","Decline.",S),("discover","54","Expired card.",H),("discover","55","Invalid PIN.",A),
+ ("discover","57","Transaction not permitted to issuer / cardholder.",H),("discover","59","Suspected fraud.",R),
+ ("discover","61","Exceeds withdrawal amount limit.",S),("discover","62","Restricted card.",H),("discover","63","Security violation.",R),
+ ("discover","65","Exceeds withdrawal count limit.",S),("discover","75","Allowable number of PIN tries exceeded.",A),
+ ("discover","87","Network unavailable.",S),("discover","91","Authorisation system or issuer system inoperative.",S),
+ ("discover","96","System malfunction.",S),("discover","N7","Decline for AVS or CID mismatch.",A),
+]
+for net, code, msg, lab in NETWORK:
+    src = "mastercard_mac" if "MAC" in code else "draft"
+    rows.append(dict(family=f"{net}:{code}", decline_code=code, decline_message=msg, label=lab, label_source=src))
+
+with open(f"{OUT}/real_seed.csv", "w", newline="") as f:
+    w = csv.DictWriter(f, fieldnames=["family", "decline_code", "decline_message", "label", "label_source"])
+    w.writeheader(); w.writerows(rows)
+from collections import Counter
+print(len(rows), "rows ->", f"{OUT}/real_seed.csv")
+print(Counter(r["label"] for r in rows)); print(Counter(r["label_source"] for r in rows))
diff --git a/ml/classifier_check.ts b/ml/classifier_check.ts
new file mode 100644
index 0000000..9c7cf8b
--- /dev/null
+++ b/ml/classifier_check.ts
@@ -0,0 +1,23 @@
+import { classifyDecline } from "../src/lib/llm/classifier";
+import { decidePolicy } from "../src/lib/policy/engine";
+
+(async () => {
+  const base = { amountPaise: 49900, attemptNumber: 1 };
+  const cases: [string, string][] = [
+    ["insufficient_funds", "Insufficient funds"],           // rule
+    ["INSUFFICIENT_BALANCE_X", "Not enough balance left"],   // model
+    ["card_blocked_by_bank", "Card was blocked by the bank, stolen"], // model, new wording
+    ["zzz_123", "qwerty"],                                   // nothing matches
+  ];
+  for (const [c, m] of cases) {
+    const r = await classifyDecline({ declineCode: c, declineMessage: m, ...base });
+    console.log(c.padEnd(24), r.method.padEnd(5), r.category.padEnd(13), r.confidence.toFixed(2));
+  }
+  process.env.CLASSIFIER_MODE = "model_only";
+  const r = await classifyDecline({ declineCode: "insufficient_funds", declineMessage: "Insufficient funds", ...base });
+  console.log("model_only".padEnd(24), r.method.padEnd(5), r.category.padEnd(13), r.confidence.toFixed(2));
+
+  const old = decidePolicy({ category: "soft_decline", attemptNumber: 1, originalFailedAt: new Date(Date.now() - 90 * 864e5) });
+  const fresh = decidePolicy({ category: "soft_decline", attemptNumber: 1, originalFailedAt: new Date() });
+  console.log("90-day-old soft decline ->", old.action, "| fresh ->", fresh.action);
+})();
